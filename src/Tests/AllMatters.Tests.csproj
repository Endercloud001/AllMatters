<Project Sdk="Godot.NET.Sdk/4.5.1">
  <Import Project="../../Paths.local.props" Condition="Exists('../../Paths.local.props')" />
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GameBranch Condition="'$(GameBranch)' == ''">public-beta</GameBranch>
    <GameDataDir Condition="'$(GameDataDir)' == '' and '$(GameBranch)' == 'public'">$(PublicGameDataDir)</GameDataDir>
    <GameDataDir Condition="'$(GameDataDir)' == '' and '$(GameBranch)' == 'public-beta'">$(BetaGameDataDir)</GameDataDir>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);MSB3270</NoWarn>
    <RitsuLibDir Condition="'$(RitsuLibDir)' == ''">$(MSBuildProjectDirectory)/../../.local/dependencies/RitsuLib-0.6.7</RitsuLibDir>
    <RitsuLibReferenceTarget Condition="'$(GameBranch)' == 'public'">0.107.1</RitsuLibReferenceTarget>
    <DefineConstants Condition="'$(GameBranch)' == 'public'">$(DefineConstants);STS2_PUBLIC</DefineConstants>
    <RitsuLibReferenceTarget Condition="'$(GameBranch)' == 'public-beta'">0.111.0</RitsuLibReferenceTarget>
  </PropertyGroup>
  <Import Project="$(RitsuLibDir)/RitsuLib.References.props" />
  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="Integration/*.cs" />
    <ProjectReference Include="../../AllMatters.csproj" />
    <Reference Include="sts2" HintPath="$(GameDataDir)/sts2.dll" />
    <Reference Include="Steamworks.NET" HintPath="$(GameDataDir)/Steamworks.NET.dll" />
    <Reference Include="0Harmony" HintPath="$(GameDataDir)/0Harmony.dll" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <AssemblyMetadata Include="DependencyDirectory" Value="$(BetaGameDataDir)" />
    <AssemblyMetadata Include="GameResourcePack" Value="$(BetaGameDataDir)/../SlayTheSpire2.pck" />
    <AssemblyMetadata Include="ModResourcePack" Value="$(MSBuildProjectDirectory)/../../dist/AllMatters.pck" />
    <AssemblyMetadata Include="RitsuLibDirectory" Value="$(RitsuLibDir)" />
    <AssemblyMetadata Include="RitsuLibTarget" Value="$(RitsuLibReferenceTarget)" />
  </ItemGroup>
</Project>
