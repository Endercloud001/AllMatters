<Project>
  <PropertyGroup>
    <BetaGameDataDir>E:/SteamLibrary/steamapps/common/Slay the Spire 2/data_sts2_windows_x86_64</BetaGameDataDir>
    <PublicGameDataDir></PublicGameDataDir>
    <GodotPath></GodotPath>
    <TestDotNetRoot>docs/local/tools/dotnet9</TestDotNetRoot>
    <IlspyPath>docs/local/tools/ilspycmd.exe</IlspyPath>
    <GameLogDir></GameLogDir>
    <!-- Unpack the complete RitsuLib 0.6.7 variant-pack here, or set an absolute directory. -->
