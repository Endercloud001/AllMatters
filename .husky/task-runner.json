{
  "$schema": "https://alirezanet.github.io/Husky.Net/schema.json",
  "tasks": [
    {
      "name": "pre-commit",
      "group": "pre-commit",
      "command": "dotnet",
      "args": ["format", "AllMatters.sln"],
      "include": ["**/*.cs"]
    },
    {
      "name": "stage-formatted",
      "group": "pre-commit",
      "command": "git",
      "args": ["add", "-u", "--", "*.cs"],
      "include": ["**/*.cs"]
    }
  ]
}
